{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3000",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/menu",
        "http://localhost:3000/booking"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
