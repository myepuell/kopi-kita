# Database Configuration (PostgreSQL in Docker)
DB_HOST=localhost
DB_PORT=5433
DB_USER=kopikita
DB_PASSWORD=kopikita_secret
DB_NAME=kopikita

# Server Configuration
PORT=4000
NODE_ENV=development
# Wajib, minimal 32 karakter acak, beda untuk lokal dan production. Tanpa ini login admin ditolak.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Hanya dipakai `npm run db:seed` ke database cloud (DATABASE_URL terisi). Minimal 12 karakter.
ADMIN_SEED_PASSWORD=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (isi di Vercel → Settings → Environment Variables; jangan commit nilainya)
# DSN boleh publik; SENTRY_AUTH_TOKEN rahasia, hanya untuk unggah source map saat build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
